DROP DATABASE locadora_bikeslikes;
CREATE DATABASE IF NOT EXISTS locadora_bikeslikes;
USE locadora_bikeslikes;

-- 1. Tabela de Clientes
CREATE TABLE clientes (
id_cliente INT AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
cpf CHAR(11) NOT NULL UNIQUE,
telefone VARCHAR(20) NOT NULL,
email VARCHAR(100),
endereco VARCHAR(255),
data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 2. Tabela de Funcionários
CREATE TABLE funcionarios (
id_funcionario INT AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
cpf CHAR(11) NOT NULL UNIQUE,
cargo VARCHAR(50) NOT NULL,
telefone VARCHAR(20) NOT NULL,
email VARCHAR(100) NOT NULL UNIQUE,
ativo BOOLEAN DEFAULT TRUE
);

-- 3. Tabela de Categorias de Bicicletas
CREATE TABLE categorias_bicicletas (
id_categoria INT AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(50) NOT NULL,
descricao TEXT,
valor_hora DECIMAL(10, 2) NOT NULL,
valor_diaria DECIMAL(10, 2) NOT NULL
);

-- 4. Tabela de Bicicletas
CREATE TABLE bicicletas (
id_bicicleta INT AUTO_INCREMENT PRIMARY KEY,
id_categoria INT NOT NULL,
codigo_patrimonio VARCHAR(30) NOT NULL UNIQUE,
marca VARCHAR(50) NOT NULL,
modelo VARCHAR(50) NOT NULL,
cor VARCHAR(30),
status VARCHAR(30) DEFAULT 'disponivel',
FOREIGN KEY (id_categoria) REFERENCES categorias_bicicletas(id_categoria)
);

-- 5. Tabela Principal de Aluguéis
CREATE TABLE alugueis (
id_aluguel INT AUTO_INCREMENT PRIMARY KEY,
id_cliente INT NOT NULL,
id_funcionario INT NOT NULL,
data_retirada DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
data_prevista_devolucao DATETIME NOT NULL,
data_devolucao_real DATETIME NULL,
valor_total DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
multa_atraso DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
status VARCHAR(30) DEFAULT 'em_andamento',
observacoes VARCHAR(200),
FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente),
FOREIGN KEY (id_funcionario) REFERENCES funcionarios(id_funcionario)
);

-- 6. Itens do Aluguel
CREATE TABLE itens_aluguel (
id_item INT AUTO_INCREMENT PRIMARY KEY,
id_aluguel INT NOT NULL,
id_bicicleta INT NOT NULL,
valor_unitario DECIMAL(10, 2) NOT NULL,
FOREIGN KEY (id_aluguel) REFERENCES alugueis(id_aluguel),
FOREIGN KEY (id_bicicleta) REFERENCES bicicletas(id_bicicleta)
);

-- 7. Tabela de Pagamentos
CREATE TABLE pagamentos (
id_pagamento INT AUTO_INCREMENT PRIMARY KEY,
id_aluguel INT NOT NULL,
valor_pago DECIMAL(10, 2) NOT NULL,
forma_pagamento VARCHAR(30) NOT NULL,
status_pagamento VARCHAR(30) DEFAULT 'aprovado',
data_pagamento DATETIME DEFAULT CURRENT_TIMESTAMP,
FOREIGN KEY (id_aluguel) REFERENCES alugueis(id_aluguel)
);

